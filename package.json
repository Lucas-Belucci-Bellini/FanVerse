{
  "name": "fanverse-platform",
  "version": "1.0.0",
  "private": true,
  "description": "FanVerse platform with Java library base and Vite-powered frontend",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:api": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.mjs",
    "sync:site-data": "node scripts/sync-site-data.mjs",
    "check:site-data": "node scripts/sync-site-data.mjs --check",
    "java:build": "node scripts/java.mjs build",
    "java:run": "node scripts/java.mjs run",
    "test:java": "node scripts/java.mjs test",
    "verify": "npm test && npm run build && npm run test:java"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
